# Copy this file to .env and fill it in. Never share your .env.

# Bot token from the Discord Developer Portal (Bot tab)
DISCORD_TOKEN=

# Optional. The bot sets up its slash commands in every server it's added to.
# Only needed if commands don't appear: right-click the server > Copy Server ID.
GUILD_ID=

# Who can use the admin controls (any one is enough; Manage Server always counts):
# Role-name keywords, comma-separated: any role whose name CONTAINS one counts
# (capitals, spaces and emoji ignored). "Leader" also matches "Leadership".
ADMIN_ROLE_KEYWORDS=Leader,Council
# A single role by ID (optional)
ADMIN_ROLE_ID=
# Discord user IDs that are always admins, comma-separated
ADMIN_USER_IDS=

# Default timings for every channel (each channel can override them with /qadmin settings)
# Slot length, "time almost up" warning, and how long someone has to press Claim (minutes)
SLOT_MINUTES=15
# Length of a booked slot (members can book start times up to 6 hours ahead)
BOOK_MINUTES=15
WARN_MINUTES=2
CLAIM_MINUTES=2

# Seconds after a turn ends before its messages are deleted (0 = keep them)
CLEANUP_SECONDS=120

# ---------------------------------------------------------------------------
# OPTIONAL: Torn API loan checks. Leave TORN_API_KEY empty to turn them off.
#
# The key must belong to a faction member who has faction API access.
# It is only used to read the faction armoury log and to look up members'
# Torn names from their Discord ID. Nothing is ever loaned or retrieved.
#
# Terms of Service for this key (Torn API: https://www.torn.com/api.html)
# | Data Storage         | Only locally: linked Torn IDs/names and loan/return times are kept in
# |                      | queue-data.json on the bot host. Armoury log lines are read, not stored.
# | Data Sharing         | Faction: loan status and unreturned weapons show on the queue panel
# | Purpose of Use       | Public community tools: confirm faction weapon loans and returns
# | Key Storage & Sharing| Stored / Used only for automation (this .env file; never shown in Discord)
# | Key Access Level     | Minimal, with faction API access. Uses: faction > news (armoury), user > basic
# ---------------------------------------------------------------------------
TORN_API_KEY=

# ---------------------------------------------------------------------------
# Tranche keys (one armoury-only key per faction tranche, added by leaders in Discord:
# Admin > API keys). Keys are encrypted with KEY_SECRET before they're saved and are
# never shown to anyone. Set KEY_SECRET to a long random string (32+ characters) and
# never change it, or saved keys can't be unlocked and must be added again.
KEY_SECRET=
# Torn faction IDs of the tranches (comma-separated)
TRANCHE_FACTIONS=19,16312,7049,22680,31764
# Queues stay locked until an admin picks the channel's tranche. Set to false to allow untranched queues.
REQUIRE_TRANCHE=true
# ---------------------------------------------------------------------------

# How often to check the armoury log while weapons are out (seconds, minimum 15)
API_POLL_SECONDS=30

# Default minutes after a slot ends before reminding someone who hasn't returned their weapon
RETURN_REMIND_MINUTES=5

# Faction news category for armoury loans. Only change this if /qadmin api-test shows no lines.
TORN_NEWS_CATEGORY=armoryAction

# Folder to save the queue in. Leave blank to use the bot's own folder.
# On Railway, attach a volume mounted at /data and set DATA_DIR=/data
DATA_DIR=
